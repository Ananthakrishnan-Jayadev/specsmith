{
  "name": "specsmith",
  "version": "0.1.0",
  "description": "SpecSmith: data feed specs, stories and tests for Confluence and Jira (Atlassian Forge)",
  "private": true,
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=24.22"
  }
}
